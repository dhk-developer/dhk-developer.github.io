{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "lib": [
      "ES2023"
    ],
    "types": []
  },
  "include": [
    "src/**/*.ts",
    "tools/**/*.ts",
    "types/**/*.d.ts"
  ]
}